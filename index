<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>مدیریت کارکرد و مرخصی ماهانه</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Vazirmatn", "IRANSans", sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        :root {
            --bg-base: #0a0d0f;
            --surface-1: #13171b;
            --surface-2: #1a2026;
            --surface-card: rgba(26, 32, 38, 0.75);
            --border-subtle: rgba(212, 175, 55, 0.14);
            --border-focus: #c5a059;
            
            --gold-primary: #d4af37;
            --gold-gradient: linear-gradient(135deg, #dfba4f 0%, #b8902e 100%);
            --emerald-accent: #10b981;
            --emerald-glow: rgba(16, 185, 129, 0.15);
            --jihad-color: #f59e0b;
            --jihad-bg: rgba(245, 158, 11, 0.1);
            
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --text-dim: #6b7280;

            --radius-xl: 24px;
            --radius-md: 16px;
            --radius-sm: 10px;
            --safe-bottom: env(safe-area-inset-bottom, 16px);
        }

        html, body {
            width: 100%;
            height: 100%;
            min-height: 100dvh;
            background: var(--bg-base);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
        }

        .app-container {
            width: 100%;
            max-width: 440px;
            height: 100dvh;
            background: radial-gradient(circle at 50% 0%, #17202a 0%, var(--bg-base) 75%);
            border: 1px solid rgba(255, 255, 255, 0.05);
            position: relative;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        @media (min-width: 480px) {
            .app-container {
                height: 92dvh;
                max-height: 860px;
                border-radius: 36px;
                border: 1px solid var(--border-subtle);
                box-shadow: 0 30px 80px rgba(0,0,0,0.8), 0 0 40px rgba(212, 175, 55, 0.06);
            }
        }

        /* ===== هدر ===== */
        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: calc(12px + env(safe-area-inset-top, 0px)) 20px 14px;
            background: rgba(19, 23, 27, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-subtle);
            flex-shrink: 0;
            z-index: 10;
        }
        .app-header h1 {
            color: var(--text-main);
            font-size: 16px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .app-header h1 svg {
            width: 22px;
            height: 22px;
            stroke: var(--gold-primary);
            stroke-width: 1.8;
        }
        .icon-btn {
            background: var(--surface-2);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        .icon-btn:active { transform: scale(0.94); }
        .icon-btn svg {
            width: 19px;
            height: 19px;
            stroke: var(--gold-primary);
            stroke-width: 1.8;
            fill: none;
        }

        /* ===== وضعیت زنده شیفت ===== */
        .live-status-bar {
            background: linear-gradient(90deg, rgba(16, 185, 129, 0.08), rgba(212, 175, 55, 0.08));
            border-bottom: 1px solid rgba(16, 185, 129, 0.2);
            padding: 8px 18px;
            font-size: 11px;
            display: none;
            justify-content: space-between;
            align-items: center;
            animation: pulseSlow 3s infinite ease-in-out;
        }
        .live-status-bar.active { display: flex; }
        .live-tag {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--emerald-accent);
            font-weight: 700;
        }
        .live-dot {
            width: 7px;
            height: 7px;
            background: var(--emerald-accent);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--emerald-accent);
        }

        /* ===== اسکرول پیج ===== */
        .page {
            display: none;
            flex: 1;
            overflow-y: auto;
            padding: 16px 16px calc(80px + var(--safe-bottom));
            -webkit-overflow-scrolling: touch;
        }
        .page.active { display: block; animation: viewFade 0.25s ease-out; }
        @keyframes viewFade {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ===== نوار پایینی ثابت ===== */
        .bottom-nav {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding-bottom: var(--safe-bottom);
            height: calc(64px + var(--safe-bottom));
            background: rgba(14, 18, 22, 0.94);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-top: 1px solid var(--border-subtle);
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 100;
        }
        .nav-item {
            flex: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: none;
            border: none;
            color: var(--text-dim);
            font-size: 11px;
            font-weight: 600;
            gap: 4px;
            cursor: pointer;
            transition: 0.2s;
        }
        .nav-item svg {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            transition: 0.2s;
        }
        .nav-item.active { color: var(--gold-primary); }
        .nav-item.active svg {
            stroke: var(--gold-primary);
            filter: drop-shadow(0 2px 8px rgba(212, 175, 55, 0.4));
        }

        /* ===== کارت‌های خلاصه لوکس ===== */
        .summary-duo {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 14px;
        }
        .sum-card {
            background: var(--surface-card);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 14px 12px;
            text-align: center;
            position: relative;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
        }
        .sum-card::after {
            content: "";
            position: absolute;
            top: 0; left: 20%; right: 20%;
            height: 1px;
            background: var(--gold-gradient);
        }
        .sum-card .label {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
        }
        .sum-card .value {
            font-size: 19px;
            font-weight: 800;
            color: var(--text-main);
            margin-top: 6px;
            letter-spacing: 0.5px;
        }
        .sum-card .sub {
            font-size: 11px;
            color: var(--gold-primary);
            font-weight: 600;
            margin-top: 4px;
            direction: rtl;
        }

        /* ===== گرید ماه‌ها ===== */
        .months-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
        .month-card {
            background: var(--surface-card);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: var(--radius-md);
            padding: 12px 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .month-card:active { transform: scale(0.98); }
        .month-card.highlight {
            border: 1px solid var(--gold-primary);
            background: linear-gradient(160deg, rgba(35, 42, 50, 0.8), rgba(20, 25, 30, 0.9));
            box-shadow: 0 4px 16px rgba(212, 175, 55, 0.08);
        }
        .month-card .month-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .month-card .month-name {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-main);
        }
        .month-card .star-btn {
            background: none;
            border: none;
            color: var(--text-dim);
            padding: 2px;
            cursor: pointer;
        }
        .month-card .star-btn.active-star { color: var(--gold-primary); }
        .month-card .star-btn svg { width: 16px; height: 16px; }

        .month-stats-rows {
            display: flex;
            flex-direction: column;
            gap: 3px;
            background: rgba(0, 0, 0, 0.25);
            padding: 6px 8px;
            border-radius: var(--radius-sm);
        }
        .month-stat-row {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            font-weight: 500;
        }
        .month-stat-row span:first-child { color: var(--text-muted); }
        .month-stat-row span:last-child { color: var(--text-main); font-weight: 600; }
        .month-stat-row.jihad span:last-child { color: var(--jihad-color); }

        /* دکمه‌های ناوبری داخلی */
        .back-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }
        .back-btn {
            background: var(--surface-2);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 6px 12px;
            color: var(--text-main);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .back-btn svg { width: 15px; height: 15px; stroke: var(--gold-primary); fill: none; stroke-width: 2; }

        .detail-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 14px;
        }
        .detail-stats.four-cols { grid-template-columns: repeat(4, 1fr); }
        .detail-stats > div {
            background: var(--surface-card);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            padding: 8px 4px;
            text-align: center;
        }
        .detail-stats span {
            font-size: 10px;
            color: var(--text-muted);
            display: block;
            margin-bottom: 2px;
        }
        .detail-stats div div {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-main);
        }

        .entry-item {
            background: var(--surface-card);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: var(--radius-md);
            padding: 10px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .entry-item .left {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .entry-item .left .main {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 600;
        }
        .badge {
            font-size: 10px;
            padding: 2px 7px;
            border-radius: 6px;
            font-weight: 600;
        }
        .badge.primary { background: rgba(16, 185, 129, 0.15); color: #34d399; }
        .badge.jihad { background: var(--jihad-bg); color: var(--jihad-color); }
        .badge.warn { background: rgba(239, 68, 68, 0.12); color: #f87171; }
        .badge.sick { background: rgba(168, 85, 247, 0.15); color: #c084fc; }
        .badge.unpaid { background: rgba(244, 63, 94, 0.15); color: #fb7185; }

        .btn-del-entry {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dim);
            padding: 4px;
            transition: 0.2s;
        }
        .btn-del-entry:hover { color: #ef4444; }
        .btn-del-entry svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; fill: none; }

        /* فرم‌ها */
        .quick-form {
            background: var(--surface-card);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-xl);
            padding: 18px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: 0 16px 40px rgba(0,0,0,0.4);
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .form-group label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border-radius: var(--radius-sm);
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(10, 13, 15, 0.6);
            color: var(--text-main);
            font-size: 13px;
            outline: none;
            -webkit-appearance: none;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: var(--gold-primary);
        }
        .type-toggle {
            display: flex;
            gap: 6px;
        }
        .type-toggle button {
            flex: 1;
            padding: 9px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: var(--radius-sm);
            background: var(--surface-2);
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            transition: 0.2s;
        }
        .type-toggle button.active {
            background: var(--gold-gradient);
            color: #0b0f12;
            font-weight: 700;
            border-color: transparent;
        }
        .btn-submit {
            padding: 12px;
            border-radius: 14px;
            border: none;
            background: var(--gold-gradient);
            color: #0c1013;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 18px rgba(212, 175, 55, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 4px;
        }
        .btn-submit:active { transform: scale(0.98); }

        .btn-pdf-export {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #fff;
            padding: 12px;
            border-radius: 14px;
            border: none;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 18px rgba(16, 185, 129, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            margin-top: 10px;
        }
        .btn-pdf-export svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; }

        .duration-preview {
            background: rgba(0, 0, 0, 0.3);
            padding: 8px;
            border-radius: var(--radius-sm);
            text-align: center;
            font-size: 11px;
            font-weight: 600;
            color: var(--gold-primary);
            border: 1px dashed var(--border-subtle);
        }

        /* ===== مودال‌ها ===== */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 16px;
        }
        .modal-overlay.open { display: flex; }
        .modal-box {
            background: var(--surface-1);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-xl);
            padding: 20px;
            width: 100%;
            max-width: 410px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.6);
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-height: 90vh;
            overflow-y: auto;
        }
        .modal-box h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-main);
            text-align: center;
        }
        .modal-actions {
            display: flex;
            gap: 8px;
            margin-top: 6px;
        }
        .modal-actions button {
            flex: 1;
            padding: 10px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            font-size: 12px;
            cursor: pointer;
        }
        .btn-cancel { background: var(--surface-2); color: var(--text-muted); }
        .btn-confirm { background: var(--gold-gradient); color: #0c1013; font-weight: 700; }

        /* بوم امضا */
        .signature-box {
            border: 1px dashed var(--gold-primary);
            border-radius: var(--radius-sm);
            background: #fff;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        #signaturePad {
            width: 100%;
            height: 110px;
            touch-action: none;
            cursor: crosshair;
        }
        .sig-tools {
            display: flex;
            width: 100%;
            justify-content: space-between;
            padding: 4px 8px;
            background: #f3f4f6;
            border-top: 1px solid #e5e7eb;
            border-radius: 0 0 var(--radius-sm) var(--radius-sm);
        }
        .sig-tools button {
            background: none;
            border: none;
            color: #ef4444;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }

        /* Toast */
        .toast-container {
            position: fixed;
            bottom: calc(75px + var(--safe-bottom));
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            pointer-events: none;
        }
        .toast {
            background: rgba(26, 32, 38, 0.95);
            border: 1px solid var(--border-subtle);
            color: var(--text-main);
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

        /* ===================================================
           طراحی چاپ اختصاصی و استاندارد گزارش PDF (A4 اداری)
           =================================================== */
        #printReportContainer {
            display: none;
        }

        @media print {
            body, html {
                background: #ffffff !important;
                color: #000000 !important;
                overflow: visible !important;
                height: auto !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .app-container, .modal-overlay, .toast-container {
                display: none !important;
            }
            #printReportContainer {
                display: block !important;
                width: 100% !important;
                max-width: 210mm !important;
                margin: 0 auto !important;
                padding: 15mm 18mm !important;
                box-sizing: border-box !important;
                font-family: "Vazirmatn", "IRANSans", -apple-system, sans-serif !important;
                color: #000000 !important;
                direction: rtl !important;
            }
            @page {
                size: A4 portrait;
                margin: 0;
            }
            .print-header {
                text-align: center;
                margin-bottom: 22px;
            }
            .print-header .bismillah {
                font-size: 14pt;
                font-weight: bold;
                margin-bottom: 12px;
            }
            .print-header h2 {
                font-size: 17pt;
                font-weight: bold;
                margin-bottom: 18px;
                letter-spacing: -0.5px;
            }
            .print-recipient {
                font-size: 11.5pt;
                font-weight: bold;
                margin-bottom: 6px;
                text-align: right;
            }
            .print-greeting {
                font-size: 11pt;
                font-weight: bold;
                margin-bottom: 10px;
                text-align: right;
            }
            .print-intro {
                font-size: 11pt;
                line-height: 1.8;
                margin-bottom: 20px;
                text-align: justify;
            }

            /* جدول ساختاریافته مطابق گزارش منبع */
            .report-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 24px;
                border: 1.5px solid #000;
            }
            .report-table th, .report-table td {
                border: 1px solid #000;
                padding: 7px 10px;
                font-size: 10.5pt;
                text-align: center;
                vertical-align: middle;
            }
            .report-table th {
                background-color: #f0f0f0 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                font-weight: bold;
            }
            .report-table .section-title {
                background-color: #e2e8f0 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                font-weight: bold;
                font-size: 11pt;
            }

            .print-footer-sign {
                margin-top: 35px;
                display: flex;
                justify-content: flex-end;
                padding-left: 20px;
            }
            .sign-box {
                text-align: center;
                width: 220px;
            }
            .sign-box .title {
                font-weight: bold;
                font-size: 11pt;
                margin-bottom: 6px;
            }
            .sign-box .date {
                font-size: 10pt;
                margin-bottom: 10px;
            }
            .sign-box img {
                max-width: 140px;
                max-height: 80px;
                object-fit: contain;
                display: block;
                margin: 0 auto;
            }
        }
    </style>
</head>
<body>

<div class="app-container">
    <div class="live-status-bar" id="liveStatusBar">
        <div class="live-tag">
            <div class="live-dot"></div>
            <span>شیفت فعال (در حال کار)</span>
        </div>
        <div style="font-weight: 700; color: var(--text-main);" id="liveShiftTime">۰:۰۰:۰۰</div>
    </div>

    <div class="app-header">
        <h1 id="pageTitle">
            <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            داشبورد مدیریت کارکرد
        </h1>
        <button class="icon-btn" id="settingsBtn" title="تنظیمات">
