            </tr>
            <tr style="background-color: #f8fafc;">
                <th colspan="2" style="font-size: 11pt; font-weight: bold;">مانده مرخصی نهایی</th>
                <td id="tableAnnualRemaining" style="font-weight: bold; font-size: 11.5pt;">۲۶ روز و ۴:۴۶ ساعت</td>
            </tr>
        </tbody>
    </table>

    <div class="print-footer-sign">
        <div class="sign-box">
            <div class="title">تاریخ و امضاء</div>
            <div class="date" id="printDate">1404/05/01</div>
            <div id="printSignatureContainer">
                <img id="printSignatureImg" src="" alt="امضا" style="display: none;" />
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    const RECORDS_KEY = 'angoshti_records_v8';
    const LEAVE_KEY = 'leaveData_v8';
    const GOALS_KEY = 'monthly_goals_v8';
    const SETTINGS_KEY = 'app_settings_v8';
    const CURRENT_MONTH_KEY = 'current_month_v8';

    const DUTY_START = 7 * 60 + 15; // 07:15
    const DUTY_END = 14 * 60 + 35;   // 14:35
    const DAILY_LEAVE_MINUTES = 7 * 60 + 20; // 7 ساعت و 20 دقیقه (440 دقیقه)

    let records = [];
    let leaveData = null;
    let monthlyGoals = {};
    let settings = {
        fullName: 'علی رفسنجانی',
        recipientTitle: 'مدیریت محترم دبیرستان پسرانه فصل رویش',
        year: 1404,
        annualLeaveDays: 30,
        dailyDutyTime: '07:20',
        workingDaysPerMonth: { 1: 23, 2: 23, 3: 23, 4: 23, 5: 23, 6: 23, 7: 23, 8: 23, 9: 23, 10: 23, 11: 23, 12: 23 },
        signatureData: ''
    };
    let currentMonth = 4; // تیر

    const monthNames = ['فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور', 'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند'];
    const monthDays = [31, 31, 31, 31, 31, 31, 30, 30, 30, 30, 30, 30];

    let summaryMonth = null;

    // پد امضا
    let sigCanvas, sigCtx, isDrawing = false;

    function initSignaturePad() {
        sigCanvas = document.getElementById('signaturePad');
        if (!sigCanvas) return;
        sigCtx = sigCanvas.getContext('2d');
        
        // مقیاس رزولوشن بالا برای کیفیت چاپ
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        sigCanvas.width = sigCanvas.offsetWidth * ratio;
        sigCanvas.height = sigCanvas.offsetHeight * ratio;
        sigCtx.scale(ratio, ratio);
        sigCtx.strokeStyle = "#000000";
        sigCtx.lineWidth = 2.2;
        sigCtx.lineCap = "round";
        sigCtx.lineJoin = "round";

        if (settings.signatureData) {
            const img = new Image();
            img.onload = () => sigCtx.drawImage(img, 0, 0, sigCanvas.offsetWidth, sigCanvas.offsetHeight);
            img.src = settings.signatureData;
        }

        function getPos(e) {
            const rect = sigCanvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return { x: clientX - rect.left, y: clientY - rect.top };
        }

        function startDraw(e) {
            isDrawing = true;
            const pos = getPos(e);
            sigCtx.beginPath();
            sigCtx.moveTo(pos.x, pos.y);
            e.preventDefault();
        }
        function draw(e) {
            if (!isDrawing) return;
            const pos = getPos(e);
            sigCtx.lineTo(pos.x, pos.y);
            sigCtx.stroke();
            e.preventDefault();
        }
        function stopDraw() { isDrawing = false; }

        sigCanvas.addEventListener('mousedown', startDraw);
        sigCanvas.addEventListener('mousemove', draw);
        window.addEventListener('mouseup', stopDraw);

        sigCanvas.addEventListener('touchstart', startDraw, { passive: false });
        sigCanvas.addEventListener('touchmove', draw, { passive: false });
        window.addEventListener('touchend', stopDraw);

        document.getElementById('clearSigBtn').onclick = () => {
            sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
            settings.signatureData = '';
        };
    }

    function loadAll() {
        try { records = JSON.parse(localStorage.getItem(RECORDS_KEY)) || []; } catch { records = []; }
        try { leaveData = JSON.parse(localStorage.getItem(LEAVE_KEY)) || null; } catch { leaveData = null; }
        if (!leaveData) {
            leaveData = { year: 1404, annualDays: 30, months: {} };
            for (let i = 1; i <= 12; i++) leaveData.months[i] = [];
        } else {
            for (let i = 1; i <= 12; i++) { if (!leaveData.months[i]) leaveData.months[i] = []; }
        }
        try { monthlyGoals = JSON.parse(localStorage.getItem(GOALS_KEY)) || {}; } catch { monthlyGoals = {}; }
        try {
            const s = JSON.parse(localStorage.getItem(SETTINGS_KEY));
            if (s) {
                settings = Object.assign(settings, s);
                if (!settings.workingDaysPerMonth) {
                    settings.workingDaysPerMonth = { 1: 23, 2: 23, 3: 23, 4: 23, 5: 23, 6: 23, 7: 23, 8: 23, 9: 23, 10: 23, 11: 23, 12: 23 };
                }
            }
        } catch { }
        try {
            const cm = localStorage.getItem(CURRENT_MONTH_KEY);
            currentMonth = (cm && !isNaN(cm)) ? parseInt(cm) : 4;
        } catch { currentMonth = 4; }
    }

    function saveAll() {
        localStorage.setItem(RECORDS_KEY, JSON.stringify(records));
        localStorage.setItem(LEAVE_KEY, JSON.stringify(leaveData));
        localStorage.setItem(GOALS_KEY, JSON.stringify(monthlyGoals));
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
        localStorage.setItem(CURRENT_MONTH_KEY, String(currentMonth));
        checkActiveShift();
    }

    function formatTime(min) {
        if (min < 0) min = 0;
        const h = Math.floor(min / 60);
        const m = min % 60;
        return h + ':' + String(m).padStart(2, '0');
    }

    function formatTimeWithSeconds(min) {
        const h = Math.floor(min / 60);
        const m = min % 60;
        return h + ':' + String(m).padStart(2, '0') + ':۰۰';
    }

    function formatMinuteText(diffMinutes) {
        const h = Math.floor(diffMinutes / 60);
        const m = diffMinutes % 60;
        if (h === 0) return `${m} دقیقه`;
        if (m === 0) return `${h} ساعت (${diffMinutes} دقیقه)`;
        return `${h} ساعت و ${m} دقیقه (${diffMinutes} دقیقه)`;
    }

    function checkActiveShift() {
        const now = new Date();
        const currentMins = now.getHours() * 60 + now.getMinutes();
        
        const monthRecs = records.filter(r => r.month === currentMonth);
        if (monthRecs.length === 0) {
            hideLiveStatus();
            return;
        }

        const sorted = [...monthRecs].sort((a,b) => (a.day*1440 + a.hour*60 + a.minute) - (b.day*1440 + b.hour*60 + b.minute));
        const last = sorted[sorted.length - 1];

        if (last && last.type === 'enter') {
            const enterMins = last.hour * 60 + last.minute;
            let duration = currentMins - enterMins;
            if (duration < 0) duration = 0;

            document.getElementById('liveStatusBar').classList.add('active');
            document.getElementById('liveShiftTime').textContent = formatTime(duration);
            
            const liveCard = document.getElementById('todayLiveCard');
            if (liveCard) {
                liveCard.style.display = 'block';
                document.getElementById('todayLiveTimer').textContent = formatMinuteText(duration);
            }
        } else {
            hideLiveStatus();
        }
    }

    function hideLiveStatus() {
        document.getElementById('liveStatusBar').classList.remove('active');
        const liveCard = document.getElementById('todayLiveCard');
        if (liveCard) liveCard.style.display = 'none';
    }

    setInterval(checkActiveShift, 30000);

    // محاسبه کارکرد
    function calculateDayBreakdown(dayRecords) {
        let total = 0, duty = 0, jihad = 0;
        let openEnter = null;

        for (const rec of dayRecords) {
            if (rec.type === 'enter') {
                if (openEnter === null) openEnter = rec;
            } else if (rec.type === 'exit' && openEnter !== null) {
                const start = openEnter.hour * 60 + openEnter.minute;
                const end = rec.hour * 60 + rec.minute;
                if (end >= start) {
                    const duration = end - start;
                    total += duration;

                    const overlapStart = Math.max(start, DUTY_START);
                    const overlapEnd = Math.min(end, DUTY_END);
                    const dutyPortion = Math.max(0, overlapEnd - overlapStart);
                    duty += dutyPortion;
                    jihad += (duration - dutyPortion);
                }
                openEnter = null;
            }
        }
        return { total, duty, jihad, waitingForExit: openEnter !== null };
    }

    function getMonthWorkBreakdown(month) {
        let total = 0, duty = 0, jihad = 0;
        const monthRecords = records.filter(r => r.month === month);
        const days = [...new Set(monthRecords.map(r => r.day))];
        for (const day of days) {
            const dayRecs = monthRecords.filter(r => r.day === day).sort((a,b) => (a.hour*60+a.minute)-(b.hour*60+b.minute));
            const res = calculateDayBreakdown(dayRecs);
            total += res.total;
            duty += res.duty;
            jihad += res.jihad;
        }
        return { total, duty, jihad, workedDaysCount: days.length };
    }

    function getLeaveEntries(month) { return leaveData.months[month] || []; }

    // محاسبه هوشمند مرخصی‌ها با انتقال خودکار به مرخصی بدون حقوق پس از پایان سقف سالانه
    function calculateSmartLeaveAnnual() {
        const totalAnnualMinutes = (settings.annualLeaveDays || 30) * DAILY_LEAVE_MINUTES;
        let cumulativeEntitledMinutes = 0;
        let annualSickMinutes = 0;
        let annualUnpaidMinutes = 0;

        const monthlyStats = {};

        // پیمایش به ترتیب ماه‌های ۱ تا ۱۲ سال
        for (let m = 1; m <= 12; m++) {
            const entries = [...getLeaveEntries(m)].sort((a, b) => a.day - b.day);
            let mEntitledMinutes = 0;
            let mSickMinutes = 0;
            let mUnpaidMinutes = 0;

            let mEntitledDay = 0;
            let mEntitledHourMin = 0;
            let mSickDay = 0;
            let mSickHourMin = 0;
            let mUnpaidDay = 0;
            let mUnpaidHourMin = 0;

            for (const entry of entries) {
                const cat = entry.category || 'entitled';
                const dur = entry.durationMin;

                if (cat === 'sick') {
                    // مرخصی استعلاجی: از مانده کسر نمی‌شود
                    mSickMinutes += dur;
                    annualSickMinutes += dur;
                    if (entry.type === 'day') mSickDay += 1;
                    else mSickHourMin += dur;
                } else {
                    // مرخصی استحقاقی عادی
                    const availableRemaining = Math.max(0, totalAnnualMinutes - cumulativeEntitledMinutes);

                    if (availableRemaining >= dur) {
                        // در سقف استحقاقی جا می‌گیرد
                        cumulativeEntitledMinutes += dur;
                        mEntitledMinutes += dur;
                        if (entry.type === 'day') mEntitledDay += 1;
                        else mEntitledHourMin += dur;
                    } else if (availableRemaining > 0) {
                        // بخشی استحقاقی، مابقی به طور خودکار بدون حقوق می‌شود
                        const entitledPart = availableRemaining;
                        const unpaidPart = dur - availableRemaining;

                        cumulativeEntitledMinutes += entitledPart;
                        mEntitledMinutes += entitledPart;
                        mEntitledHourMin += entitledPart;

                        mUnpaidMinutes += unpaidPart;
                        annualUnpaidMinutes += unpaidPart;
                        mUnpaidHourMin += unpaidPart;
                    } else {
                        // سقف استحقاقی کاملاً تمام شده؛ تماماً بدون حقوق منظور می‌شود
                        mUnpaidMinutes += dur;
                        annualUnpaidMinutes += dur;
                        if (entry.type === 'day') mUnpaidDay += 1;
                        else mUnpaidHourMin += dur;
                    }
                }
            }

            monthlyStats[m] = {
                entitledMinutes: mEntitledMinutes,
                sickMinutes: mSickMinutes,
                unpaidMinutes: mUnpaidMinutes,
                entitledDay: mEntitledDay,
                entitledHourMin: mEntitledHourMin,
                sickDay: mSickDay,
                sickHourMin: mSickHourMin,
                unpaidDay: mUnpaidDay,
                unpaidHourMin: mUnpaidHourMin,
                totalMonthMinutes: mEntitledMinutes + mSickMinutes + mUnpaidMinutes
            };
        }

        const remainingMinutes = Math.max(0, totalAnnualMinutes - cumulativeEntitledMinutes);
        return {
            totalAnnualMinutes,
            cumulativeEntitledMinutes,
            annualSickMinutes,
            annualUnpaidMinutes,
            remainingMinutes,
            monthlyStats
        };
    }

    function renderHome() {
        const leaveCalc = calculateSmartLeaveAnnual();

        const remDays = Math.floor(leaveCalc.remainingMinutes / DAILY_LEAVE_MINUTES);
        const remModMin = leaveCalc.remainingMinutes % DAILY_LEAVE_MINUTES;
        const remHours = Math.floor(remModMin / 60);
        const remMins = remModMin % 60;

        document.getElementById('totalLeaveValue').textContent = formatTime(leaveCalc.cumulativeEntitledMinutes);
        document.getElementById('remainingLeaveValue').textContent = formatTime(leaveCalc.remainingMinutes);
        document.getElementById('remainingLeaveDays').textContent = `${remDays} روز و ${remHours}:${String(remMins).padStart(2, '0')}`;

        const grid = document.getElementById('monthsGrid');
        let html = '';
        for (let i = 1; i <= 12; i++) {
            const workData = getMonthWorkBreakdown(i);
            const mLeave = leaveCalc.monthlyStats[i];
            const isHighlight = (i === currentMonth);
            const isStarred = (i === currentMonth);

            html += `
                <div class="month-card ${isHighlight ? 'highlight' : ''}" data-month="${i}">
                    <div class="month-header">
                        <span class="month-name">${monthNames[i-1]}</span>
                        <button class="star-btn ${isStarred ? 'active-star' : ''}" data-month="${i}">
                            <svg viewBox="0 0 24 24" fill="${isStarred ? 'currentColor' : 'none'}" stroke="currentColor"><polygon points="12 17.27 18.18 21 16.54 13.97 22 9.24 14.81 8.63 12 2 9.19 8.63 2 9.24 7.46 13.97 5.82 21 12 17.27"/></svg>
                        </button>
                    </div>
                    <div class="month-stats-rows">
                        <div class="month-stat-row"><span>کارکرد:</span><span>${formatTime(workData.total)}</span></div>
                        <div class="month-stat-row jihad"><span>ساعت مازاد:</span><span>${formatTime(workData.jihad)}</span></div>
                        <div class="month-stat-row"><span>مرخصی استحقاقی:</span><span>${formatTime(mLeave.entitledMinutes)}</span></div>
                    </div>
                </div>
            `;
        }
        grid.innerHTML = html;

        grid.querySelectorAll('.month-card').forEach(card => {
            card.addEventListener('click', function(e) {
                if (e.target.closest('.star-btn')) return;
                showSummary(parseInt(this.dataset.month));
            });
        });

        grid.querySelectorAll('.star-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const m = parseInt(this.dataset.month);
                currentMonth = m;
                saveAll();
                renderHome();
                showToast(`ماه ${monthNames[m-1]} فعال شد.`);
            });
        });

        checkActiveShift();
    }

    function showSummary(month) {
        summaryMonth = month;
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.getElementById('page-summary').classList.add('active');

        const workData = getMonthWorkBreakdown(month);
        const leaveCalc = calculateSmartLeaveAnnual();
        const mLeave = leaveCalc.monthlyStats[month];

        document.getElementById('summaryMonthTitle').textContent = monthNames[month - 1];
        document.getElementById('sumLeaveValue').textContent = formatTime(mLeave.entitledMinutes);
        document.getElementById('sumWorkValue').textContent = formatTime(workData.total);
        document.getElementById('sumJihadValue').textContent = formatTime(workData.jihad);

        document.getElementById('sumLeaveCard').onclick = () => showLeaveDetail(month);
        document.getElementById('sumWorkCard').onclick = () => showWorkDetail(month);
    }

    function showLeaveDetail(month) {
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.getElementById('page-leave-detail').classList.add('active');
        document.getElementById('leaveDetailTitle').textContent = 'مرخصی - ' + monthNames[month - 1];

        const leaveCalc = calculateSmartLeaveAnnual();
        const mStats = leaveCalc.monthlyStats[month];

        document.getElementById('leaveEntitledTime').textContent = formatTime(mStats.entitledMinutes);
        document.getElementById('leaveSickTime').textContent = formatTime(mStats.sickMinutes);
        document.getElementById('leaveUnpaidTime').textContent = formatTime(mStats.unpaidMinutes);
        document.getElementById('leaveTotalTime').textContent = formatTime(mStats.totalMonthMinutes);

        const entries = [...getLeaveEntries(month)];
        const list = document.getElementById('leaveEntriesList');
        if (entries.length === 0) {
            list.innerHTML = '<div style="text-align:center; padding:30px; color:var(--text-dim); font-size:12px;">موردی ثبت نشده است.</div>';
        } else {
            entries.sort((a, b) => b.day - a.day);
            let html = '';
            entries.forEach(e => {
                const cat = e.category || 'entitled';
                const catLabel = cat === 'sick' ? 'استعلاجی' : 'استحقاقی';
                const catClass = cat === 'sick' ? 'sick' : 'primary';
                const typeLabel = e.type === 'day' ? 'روزانه' : 'ساعتی';
                const durText = e.type === 'day' ? '۷:۲۰' : formatMinuteText(e.durationMin);
                html += `
                    <div class="entry-item">
                        <div class="left">
                            <div class="main">
                                <span class="badge ${catClass}">${catLabel} (${typeLabel})</span>
                                <span>روز ${e.day}</span>
                                <span style="color:var(--gold-primary); font-weight:700;">${durText}</span>
                            </div>
                            ${e.note ? `<div style="font-size:11px; color:var(--text-muted);">${e.note}</div>` : ''}
                        </div>
                        <button class="btn-del-entry btn-del-leave" data-id="${e.id}">
                            <svg viewBox="0 0 24 24"><path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                    </div>
                `;
            });
            list.innerHTML = html;

            list.querySelectorAll('.btn-del-leave').forEach(b => {
                b.onclick = function() {
                    const id = this.dataset.id;
                    if (confirm('مرخصی حذف شود؟')) {
                        leaveData.months[month] = leaveData.months[month].filter(x => x.id != id);
                        saveAll();
                        showLeaveDetail(month);
                        renderHome();
                    }
                };
            });
        }
        document.getElementById('addLeaveFromDetail').onclick = () => openModalLeave(month);
    }

    function showWorkDetail(month) {
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.getElementById('page-work-detail').classList.add('active');
        document.getElementById('workDetailTitle').textContent = 'تردد - ' + monthNames[month - 1];

        const workData = getMonthWorkBreakdown(month);
        document.getElementById('workTotalTime').textContent = formatTime(workData.total);
        document.getElementById('workDutyTime').textContent = formatTime(workData.duty);
        document.getElementById('workJihadTime').textContent = formatTime(workData.jihad);
        document.getElementById('workDaysCount').textContent = workData.workedDaysCount + ' روز';

        const monthRecords = records.filter(r => r.month === month);
        const days = [...new Set(monthRecords.map(r => r.day))].sort((a, b) => b - a);

        const list = document.getElementById('workEntriesList');
        if (days.length === 0) {
            list.innerHTML = '<div style="text-align:center; padding:30px; color:var(--text-dim); font-size:12px;">ترددی موجود نیست.</div>';
        } else {
            let html = '';
            for (const day of days) {
                const dayRecs = monthRecords.filter(r => r.day === day).sort((a,b) => (a.hour*60+a.minute)-(b.hour*60+b.minute));
                const calc = calculateDayBreakdown(dayRecs);
                html += `
                    <div style="margin:12px 2px 6px; font-weight:700; font-size:11px; color:var(--text-muted); display:flex; justify-content:space-between;">
                        <span>روز ${day}</span>
                        <span>مجموع: ${formatTime(calc.total)} | ساعت مازاد: ${formatTime(calc.jihad)}</span>
                    </div>
                `;
                for (const r of dayRecs) {
                    const isEnter = r.type === 'enter';
                    const timeMinutes = r.hour * 60 + r.minute;
                    const isJihadTime = (timeMinutes < DUTY_START || timeMinutes > DUTY_END);
                    html += `
                        <div class="entry-item">
                            <div class="left">
                                <div class="main">
                                    <span class="badge ${isEnter ? 'primary' : 'warn'}">${isEnter ? 'ورود' : 'خروج'}</span>
                                    <span>${String(r.hour).padStart(2,'0')}:${String(r.minute).padStart(2,'0')}</span>
                                    ${isJihadTime ? '<span class="badge jihad">ساعت مازاد</span>' : ''}
                                </div>
                                ${r.note ? `<div style="font-size:11px; color:var(--text-muted);">${r.note}</div>` : ''}
                            </div>
                            <button class="btn-del-entry btn-del-work" data-id="${r.id}">
                                <svg viewBox="0 0 24 24"><path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            </button>
                        </div>
                    `;
                }
            }
            list.innerHTML = html;

            list.querySelectorAll('.btn-del-work').forEach(b => {
                b.onclick = function() {
                    const id = this.dataset.id;
                    if (confirm('حذف این تردد تایید می‌شود؟')) {
                        records = records.filter(r => r.id != id);
                        saveAll();
                        showWorkDetail(month);
                        renderHome();
                    }
                };
            });
        }
        document.getElementById('addWorkFromDetail').onclick = () => openModalWork(month);
    }

    function updateCalcDuration(startVal, endVal, targetElemId) {
        const [sh, sm] = startVal.split(':').map(Number);
        const [eh, em] = endVal.split(':').map(Number);
        let diff = (eh * 60 + em) - (sh * 60 + sm);
        if (diff < 0) diff += 24 * 60;
        document.getElementById(targetElemId).textContent = `مدت: ${formatMinuteText(diff)}`;
        return diff;
    }

    function initQuickLeave() {
        const startInput = document.getElementById('quickLeaveStartTime');
        const endInput = document.getElementById('quickLeaveEndTime');

        const updateDur = () => updateCalcDuration(startInput.value, endInput.value, 'quickLeaveDuration');
        startInput.addEventListener('input', updateDur);
        endInput.addEventListener('input', updateDur);

        document.querySelectorAll('#leaveCategoryToggle button').forEach(b => {
            b.onclick = function() {
                document.querySelectorAll('#leaveCategoryToggle button').forEach(x => x.classList.remove('active'));
                this.classList.add('active');
            };
        });

        document.querySelectorAll('#leaveTypeToggle button').forEach(b => {
            b.onclick = function() {
                document.querySelectorAll('#leaveTypeToggle button').forEach(x => x.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('quickLeaveHourInputs').style.display = (this.dataset.type === 'hour') ? 'block' : 'none';
            };
        });

        document.getElementById('quickLeaveSubmit').onclick = function() {
            const targetMonth = parseInt(document.getElementById('quickLeaveMonth').value) || currentMonth;
            const day = parseInt(document.getElementById('quickLeaveDay').value);
            const category = document.querySelector('#leaveCategoryToggle button.active').dataset.cat;
            const type = document.querySelector('#leaveTypeToggle button.active').dataset.type;
            const note = document.getElementById('quickLeaveNote').value.trim();
            if (!day || day < 1 || day > monthDays[targetMonth - 1]) {
                showToast('شماره روز وارد شده صحیح نیست.');
                return;
            }
            let dur = (type === 'hour') ? updateCalcDuration(startInput.value, endInput.value, 'quickLeaveDuration') : DAILY_LEAVE_MINUTES;

            leaveData.months[targetMonth].push({
                id: Date.now() + Math.random(),
                year: settings.year,
                month: targetMonth,
                day,
                category,
                type,
                durationMin: dur,
                note
            });
            saveAll();
            renderHome();
            showToast('مرخصی با موفقیت ثبت شد.');
            document.getElementById('quickLeaveDay').value = '';
            document.getElementById('quickLeaveNote').value = '';
        };
    }

    function initQuickWork() {
        document.getElementById('quickWorkNow').onclick = function() {
            const d = new Date();
            document.getElementById('quickWorkTime').value = String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
        };
        document.getElementById('quickWorkSubmit').onclick = function() {
            const targetMonth = parseInt(document.getElementById('quickWorkMonth').value) || currentMonth;
            const day = parseInt(document.getElementById('quickWorkDay').value);
            const type = document.getElementById('quickWorkType').value;
            const time = document.getElementById('quickWorkTime').value;
            const note = document.getElementById('quickWorkNote').value.trim();
            if (!day || day < 1 || day > monthDays[targetMonth - 1]) {
                showToast('روز معتبر نیست.');
                return;
            }
            const [h, m] = time.split(':').map(Number);
            records.push({
                id: 'rec_' + Date.now(),
                month: targetMonth,
                day,
                type,
                hour: h,
                minute: m,
                note
            });
            saveAll();
            renderHome();
            showToast('تردد با موفقیت افزوده شد.');
            document.getElementById('quickWorkDay').value = '';
            document.getElementById('quickWorkNote').value = '';
        };
    }

    function openModalLeave(month) {
        document.getElementById('leaveEntryModal').classList.add('open');
        const startInput = document.getElementById('leaveEntryStartTime');
        const endInput = document.getElementById('leaveEntryEndTime');
        const updateDur = () => updateCalcDuration(startInput.value, endInput.value, 'modalLeaveDuration');
        startInput.oninput = updateDur;
        endInput.oninput = updateDur;
        updateDur();

        document.querySelectorAll('#modalLeaveCategoryToggle button').forEach(b => {
            b.onclick = function() {
                document.querySelectorAll('#modalLeaveCategoryToggle button').forEach(x => x.classList.remove('active'));
                this.classList.add('active');
            };
        });

        document.querySelectorAll('#modalLeaveTypeToggle button').forEach(b => {
            b.onclick = function() {
                document.querySelectorAll('#modalLeaveTypeToggle button').forEach(x => x.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('modalLeaveHourInputs').style.display = (this.dataset.type === 'hour') ? 'block' : 'none';
            };
        });

        document.getElementById('leaveEntryCancel').onclick = () => document.getElementById('leaveEntryModal').classList.remove('open');
        document.getElementById('leaveEntryConfirm').onclick = function() {
            const day = parseInt(document.getElementById('leaveEntryDay').value);
            const category = document.querySelector('#modalLeaveCategoryToggle button.active').dataset.cat;
            const type = document.querySelector('#modalLeaveTypeToggle button.active').dataset.type;
            const note = document.getElementById('leaveEntryNote').value.trim();
            if (!day || day < 1 || day > monthDays[month - 1]) {
                showToast('روز نامعتبر است.');
                return;
            }
            let dur = (type === 'day') ? DAILY_LEAVE_MINUTES : updateCalcDuration(startInput.value, endInput.value, 'modalLeaveDuration');
            leaveData.months[month].push({
                id: Date.now() + Math.random(),
                year: settings.year,
                month,
                day,
                category,
                type,
                durationMin: dur,
                note
            });
            saveAll();
            document.getElementById('leaveEntryModal').classList.remove('open');
            showLeaveDetail(month);
            renderHome();
            showToast('مرخصی با موفقیت ثبت شد.');
        };
    }

    function openModalWork(month) {
        document.getElementById('workEntryModal').classList.add('open');
        document.getElementById('workEntryCancel').onclick = () => document.getElementById('workEntryModal').classList.remove('open');
        document.getElementById('workEntryConfirm').onclick = function() {
            const day = parseInt(document.getElementById('workEntryDay').value);
            const type = document.getElementById('workEntryType').value;
            const [h, m] = document.getElementById('workEntryTime').value.split(':').map(Number);
            const note = document.getElementById('workEntryNote').value.trim();
            if (!day || day < 1 || day > monthDays[month - 1]) {
                showToast('روز نامعتبر است.');
                return;
            }
            records.push({
                id: 'rec_' + Date.now(),
                month,
                day,
                type,
                hour: h,
                minute: m,
                note
            });
            saveAll();
            document.getElementById('workEntryModal').classList.remove('open');
            showWorkDetail(month);
            renderHome();
            showToast('تردد با موفقیت افزوده شد.');
        };
    }

    function initSettings() {
        document.getElementById('settingsBtn').onclick = function() {
            document.getElementById('settingsFullName').value = settings.fullName || '';
            document.getElementById('settingsRecipientTitle').value = settings.recipientTitle || '';
            document.getElementById('settingsYear').value = settings.year || 1404;
            document.getElementById('settingsAnnualLeaveDays').value = settings.annualLeaveDays || 30;
            document.getElementById('settingsDailyDutyTime').value = settings.dailyDutyTime || '07:20';
            const m = summaryMonth || currentMonth;
            document.getElementById('settingsWorkingDays').value = (settings.workingDaysPerMonth && settings.workingDaysPerMonth[m]) ? settings.workingDaysPerMonth[m] : 23;
            document.getElementById('settingsModal').classList.add('open');
            setTimeout(initSignaturePad, 100);
        };

        document.getElementById('settingsCancel').onclick = () => document.getElementById('settingsModal').classList.remove('open');
        
        document.getElementById('settingsSave').onclick = function() {
            settings.fullName = document.getElementById('settingsFullName').value.trim() || 'علی رفسنجانی';
            settings.recipientTitle = document.getElementById('settingsRecipientTitle').value.trim() || 'مدیریت محترم دبیرستان پسرانه فصل رویش';
            settings.year = parseInt(document.getElementById('settingsYear').value) || 1404;
            settings.annualLeaveDays = parseInt(document.getElementById('settingsAnnualLeaveDays').value) || 30;
            settings.dailyDutyTime = document.getElementById('settingsDailyDutyTime').value.trim() || '07:20';
            
            const m = summaryMonth || currentMonth;
            if (!settings.workingDaysPerMonth) settings.workingDaysPerMonth = {};
            settings.workingDaysPerMonth[m] = parseInt(document.getElementById('settingsWorkingDays').value) || 23;

            // ذخیره تصویر امضا
            if (sigCanvas) {
                settings.signatureData = sigCanvas.toDataURL('image/png');
            }

            saveAll();
            renderHome();
            document.getElementById('settingsModal').classList.remove('open');
            showToast('تنظیمات با موفقیت ذخیره شد.');
        };

        document.getElementById('backupDownload').onclick = function() {
            const blob = new Blob([JSON.stringify({ records, leaveData, monthlyGoals, settings })], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `backup_work_${settings.year}.json`;
            a.click();
        };
        document.getElementById('backupUploadBtn').onclick = () => document.getElementById('backupFileInput').click();
        document.getElementById('backupFileInput').onchange = function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(evt) {
                try {
                    const data = JSON.parse(evt.target.result);
                    if (data.records) records = data.records;
                    if (data.leaveData) leaveData = data.leaveData;
                    if (data.monthlyGoals) monthlyGoals = data.monthlyGoals;
                    if (data.settings) settings = data.settings;
                    saveAll();
                    renderHome();
                    showToast('داده‌ها بازیابی شد.');
                } catch {
                    showToast('خطا در بارگذاری فایل.');
                }
            };
            reader.readAsText(file);
        };
    }

    // ==========================================
    // آماده‌سازی و پرینت/PDF گزارش ماهانه
    // ==========================================
    function setupPdfExport() {
        document.getElementById('generatePdfBtn').onclick = function() {
            const m = summaryMonth || currentMonth;
            const monthName = monthNames[m - 1];
            const workData = getMonthWorkBreakdown(m);
            const leaveCalc = calculateSmartLeaveAnnual();
            const mLeave = leaveCalc.monthlyStats[m];

            // مقادیر موظفی ماه
            const workingDays = (settings.workingDaysPerMonth && settings.workingDaysPerMonth[m]) ? settings.workingDaysPerMonth[m] : 23;
            const [dh, dm] = (settings.dailyDutyTime || '07:20').split(':').map(Number);
            const dailyDutyMin = (dh * 60 + dm);
            const totalDutyMinutes = workingDays * dailyDutyMin;

            // متن‌ها و عناوین
            document.getElementById('printRecipient').textContent = settings.recipientTitle || 'مدیریت محترم دبیرستان پسرانه فصل رویش';
            document.getElementById('printIntro').textContent = `بدینوسیله اینجانب ${settings.fullName || 'علی رفسنجانی'} گزارش کارکرد خود در ${monthName} ماه ${settings.year || 1404} را اعلام می نمایم.`;

            // جدول: موظفی
            document.getElementById('tableDutyDays').textContent = workingDays;
            document.getElementById('tableDutyPerDay').textContent = settings.dailyDutyTime || '۷:۲۰';
            document.getElementById('tableTotalDutyHours').textContent = formatTime(totalDutyMinutes);

            // جدول: کارکرد
            document.getElementById('tableWorkDays').textContent = workData.workedDaysCount;
            document.getElementById('tableWorkHours').textContent = formatTimeWithSeconds(workData.total);

            // جدول: ساعت مازاد (دقیقاً برابر با ساعت جهادی ماه)
            document.getElementById('tableJihadHours').textContent = `${formatTime(workData.jihad)} ساعت`;

            // جدول: مرخصی این ماه
            document.getElementById('tableLeaveEntitledDay').textContent = `${mLeave.entitledDay} روز`;
            document.getElementById('tableLeaveEntitledHour').textContent = `${formatTime(mLeave.entitledHourMin)} ساعت`;

            document.getElementById('tableLeaveSickDay').textContent = `${mLeave.sickDay} روز`;
            document.getElementById('tableLeaveSickHour').textContent = `${formatTime(mLeave.sickHourMin)} ساعت`;

            document.getElementById('tableLeaveUnpaidDay').textContent = `${mLeave.unpaidDay} روز`;
            document.getElementById('tableLeaveUnpaidHour').textContent = `${formatTime(mLeave.unpaidHourMin)} ساعت`;

            // جدول: وضعیت سالانه مرخصی
            document.getElementById('tableAnnualTotalDays').textContent = `${(settings.annualLeaveDays || 30)}.۰ روز`;

            // کل مرخصی استحقاقی استفاده شده تا این ماه
            let usedEntitledMinUpToMonth = 0;
            let usedSickMinUpToMonth = 0;
            for (let i = 1; i <= m; i++) {
                usedEntitledMinUpToMonth += leaveCalc.monthlyStats[i].entitledMinutes;
                usedSickMinUpToMonth += leaveCalc.monthlyStats[i].sickMinutes;
            }
            const usedEDays = Math.floor(usedEntitledMinUpToMonth / DAILY_LEAVE_MINUTES);
            const usedEMod = usedEntitledMinUpToMonth % DAILY_LEAVE_MINUTES;
            document.getElementById('tableAnnualUsedEntitled').textContent = `${usedEDays} روز و ${formatTime(usedEMod)} ساعت`;

            const usedSDays = Math.floor(usedSickMinUpToMonth / DAILY_LEAVE_MINUTES);
            const usedSMod = usedSickMinUpToMonth % DAILY_LEAVE_MINUTES;
            document.getElementById('tableAnnualUsedSick').textContent = `${usedSDays} روز و ${formatTime(usedSMod)} ساعت`;

            // مانده مرخصی تا پایان این ماه
            const remainingMinUpToMonth = Math.max(0, (settings.annualLeaveDays || 30) * DAILY_LEAVE_MINUTES - usedEntitledMinUpToMonth);
            const remDays = Math.floor(remainingMinUpToMonth / DAILY_LEAVE_MINUTES);
            const remMod = remainingMinUpToMonth % DAILY_LEAVE_MINUTES;
            
            // در نمونه گزارش، دو ردیف برای مانده و قابل استفاده درج شده بود
            document.getElementById('tableAnnualUsable').textContent = `${remDays} روز و ${formatTime(remMod)} ساعت`;
            document.getElementById('tableAnnualRemaining').textContent = `${remDays} روز و ${formatTime(remMod)} ساعت`;

            // تاریخ و امضا
            const nextMonth = (m % 12) + 1;
            const nextMonthYear = (m === 12) ? (settings.year + 1) : settings.year;
            document.getElementById('printDate').textContent = `${nextMonthYear}/${String(nextMonth).padStart(2,'0')}/01`;

            const sigImg = document.getElementById('printSignatureImg');
            if (settings.signatureData) {
                sigImg.src = settings.signatureData;
                sigImg.style.display = 'block';
            } else {
                sigImg.style.display = 'none';
            }

            // فراخوانی پنجره پرینت و تولید خودکار PDF
            window.print();
        };
    }

    function showToast(msg) {
        const c = document.getElementById('toastContainer');
        const t = document.createElement('div');
        t.className = 'toast';
        t.textContent = msg;
        c.appendChild(t);
        setTimeout(() => t.remove(), 2200);
    }

    document.querySelectorAll('.nav-item').forEach(item => {
        item.addEventListener('click', function() {
            const targetPage = this.dataset.page;
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.getElementById(targetPage).classList.add('active');
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            this.classList.add('active');
            if (targetPage === 'page-home') renderHome();
            if (targetPage === 'page-quick-leave') {
                const sel = document.getElementById('quickLeaveMonth');
                if (sel) sel.value = String(currentMonth);
            }
            if (targetPage === 'page-quick-work') {
                const sel = document.getElementById('quickWorkMonth');
                if (sel) sel.value = String(currentMonth);
            }
            checkActiveShift();
        });
    });

    document.getElementById('summaryBackBtn').onclick = () => {
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.getElementById('page-home').classList.add('active');
        renderHome();
    };
    document.getElementById('leaveDetailBackBtn').onclick = () => showSummary(summaryMonth);
    document.getElementById('workDetailBackBtn').onclick = () => showSummary(summaryMonth);

    loadAll();
    renderHome();
    initQuickLeave();
    initQuickWork();
    initSettings();
    setupPdfExport();
})();
</script>
